<?xml version="1.0" encoding="utf-8"?>
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <!--
        The artwork lives entirely in the BACKGROUND layer, full-bleed and fully opaque, with an
        empty foreground.

        The usual split (art in the foreground, colour behind) gave the logo its own silhouette
        inside the icon, and the launcher's icon shadow traced that silhouette as a faint dark ring
        — visible with both the original #1f1f1f backdrop and a transparent one. Because this logo
        is a full-bleed gradient rather than a glyph, there is nothing to gain from the foreground
        layer's parallax: putting it in the background means every mask shape cuts through solid
        pixels with no internal edge for a shadow to find.
    -->
    <background android:drawable="@mipmap/ic_launcher_background" />
    <foreground android:drawable="@drawable/ic_launcher_empty" />
    <monochrome android:drawable="@drawable/ic_launcher_monochrome" />
</adaptive-icon>
